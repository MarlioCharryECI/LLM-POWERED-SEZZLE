# Default backend is local Ollama ($0) — no key needed.
# Just run:  ollama pull qwen2.5:7b  &&  ollama serve

# Optional overrides:
# SEZZLE_PROVIDER=ollama          # ollama (default) | anthropic | openai
# SEZZLE_MODEL=qwen2.5:7b         # default local model
# SEZZLE_OLLAMA_URL=http://localhost:11434

# Only needed if you switch to a paid provider (last resort):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
